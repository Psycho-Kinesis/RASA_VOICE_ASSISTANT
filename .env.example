# Copy this file to `.env` in the project root and fill in your own values.

# --- Required ---------------------------------------------------------

# Claude (Anthropic) API - powers the LLM responses in llm_service.py.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs - text-to-speech in voice_interface.py. Without this the
# assistant still thinks, but every reply prints
# "ElevenLabs API key not provided!" instead of being spoken.
# Note the variable name: the code reads ELEVEN_LABS_API2, not
# ELEVENLABS_API_KEY.
ELEVEN_LABS_API2=your_elevenlabs_api_key_here

# --- Optional ---------------------------------------------------------

# Override the Claude model. Defaults to claude-opus-5.
# claude-haiku-4-5 is a cheaper, lower-latency option for live calls.
# ANTHROPIC_MODEL=claude-opus-5
